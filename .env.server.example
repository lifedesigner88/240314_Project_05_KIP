APP_ENV_FILE=.env.server

SPRING_PROFILES_ACTIVE=demo

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=kip
DB_USERNAME=kip
DB_PASSWORD=change-me

MARIADB_DATABASE=kip
MARIADB_USER=kip
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

JWT_SECRET_KEY=replace-with-a-32-byte-or-longer-secret
JWT_EXPIRATION_MINUTES=720
JWT_ISSUER=kip-demo

FEATURE_PUSH_ENABLED=false
FEATURE_SEARCH_ENABLED=false
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

AWS_REGION=ap-northeast-2
STORAGE_BUCKET=kip-demo
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_BASE_URL=https://vue-spring-file.sejongclass.kr
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_AUTO_CREATE_BUCKET=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ALLOWED_ORIGINS=https://vue-spring.sejongclass.kr
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m

NUXT_PUBLIC_API_BASE_URL=https://vue-spring.sejongclass.kr/api
NUXT_PUBLIC_PUSH_ENABLED=false

FRONTEND_PORT=3000
BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
